<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>液态通知</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
            <key>footerText</key><string>锁屏通知美化：流动渐变（颜色可自定义）、出现动画与触摸反馈、通知大小可调。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>通知大小</string>
            <key>key</key><string>notify_scale</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.6</real>
            <key>max</key><real>1.5</real>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>界面净化</string>
            <key>footerText</key><string>隐藏 iOS 自带的「通知中心」标题文字与「清除所有通知」按钮（改完 respring 生效）。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>隐藏「通知中心」标题</string>
            <key>key</key><string>hide_nc_title</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>隐藏「清除所有通知」按钮</string>
            <key>key</key><string>hide_clear_all</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><true/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>鱼缸游鱼</string>
            <key>footerText</key><string>每条通知背景里游动的小鱼，数量/大小可调。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用鱼缸游鱼</string>
            <key>key</key><string>fish_on</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>鱼的数量</string>
            <key>key</key><string>fish_count</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>3</real>
            <key>min</key><real>1</real>
            <key>max</key><real>8</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>鱼的大小</string>
            <key>key</key><string>fish_size</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.5</real>
            <key>max</key><real>2.0</real>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>流动渐变背景</string>
            <key>footerText</key><string>双色渐变在通知背景上缓慢流动，色相可自由调。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用流动渐变</string>
            <key>key</key><string>gradient_on</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>渐变色相 A</string>
            <key>key</key><string>gradient_hue1</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>0.5</real>
            <key>min</key><real>0.0</real>
            <key>max</key><real>1.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>渐变色相 B</string>
            <key>key</key><string>gradient_hue2</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>0.85</real>
            <key>min</key><real>0.0</real>
            <key>max</key><real>1.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>流动速度</string>
            <key>key</key><string>gradient_speed</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>0.3</real>
            <key>min</key><real>0.02</real>
            <key>max</key><real>2.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>渐变透明度</string>
            <key>key</key><string>gradient_opacity</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>0.35</real>
            <key>min</key><real>0.05</real>
            <key>max</key><real>1.0</real>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>配色智能</string>
            <key>footerText</key><string>「图标取色」= 每条通知渐变跟随该 App 图标主色；「壁纸取色」= 跟随桌面壁纸主色。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>label</key><string>配色来源</string>
            <key>key</key><string>color_source</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><integer>0</integer>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
                <integer>2</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>手动</string>
                <string>图标</string>
                <string>壁纸</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>深色模式自动压暗</string>
            <key>key</key><string>dark_dim</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>粒子特效（通知内飘落）</string>
            <key>footerText</key><string>「自动」按季节换（冬❄️/春🌸/夏⭐/秋🍂）；「自定义」用下方输入的 emoji，多个取中间一个。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>label</key><string>粒子样式</string>
            <key>key</key><string>particle_style</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><integer>0</integer>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
                <integer>2</integer>
                <integer>3</integer>
                <integer>4</integer>
                <integer>5</integer>
                <integer>6</integer>
                <integer>7</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>关</string>
                <string>❄️</string>
                <string>🌸</string>
                <string>🍂</string>
                <string>⭐</string>
                <string>❤️</string>
                <string>自动</string>
                <string>自定义</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>粒子大小</string>
            <key>key</key><string>particle_size</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.5</real>
            <key>max</key><real>2.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidTextFieldCell</string>
            <key>label</key><string>自定义粒子 emoji</string>
            <key>key</key><string>particle_custom</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><string>✨</string>
            <key>placeholder</key><string>如 🎉（选「自定义」档生效）</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>动画反馈</string>
            <key>footerText</key><string>出现动画：果冻弹跳 / 除雾渐显 / 挤压拉伸 / 凝胶膨胀。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>label</key><string>出现动画</string>
            <key>key</key><string>appear_mode</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><integer>1</integer>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
                <integer>2</integer>
                <integer>3</integer>
                <integer>4</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>关</string>
                <string>果冻</string>
                <string>除雾</string>
                <string>挤压拉伸</string>
                <string>凝胶</string>
            </array>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>动画强度</string>
            <key>key</key><string>elastic_intensity</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.2</real>
            <key>max</key><real>2.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>触摸反馈（渐变闪亮 + 微挤压）</string>
            <key>key</key><string>touch_glow_on</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>到达粒子爆发</string>
            <key>key</key><string>burst_on</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>爆发强度</string>
            <key>key</key><string>burst_intensity</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.2</real>
            <key>max</key><real>2.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>消失消散（划走溶解）</string>
            <key>key</key><string>dissolve_on</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>

    </array>
</dict>
</plist>
