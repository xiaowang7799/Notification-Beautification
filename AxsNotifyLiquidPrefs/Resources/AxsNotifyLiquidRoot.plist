    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
            <key>footerText</key><string>锁屏通知液态美化：流动渐变、玻璃高光、波浪边缘、弹性出现，通知大小可调。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsNotifyLiquidSliderCell</string>
            <key>label</key><string>通知大小</string>
            <key>key</key><string>notify_scale</string>
            <key>defaults</key><string>com.axs.notifyliquid</string>
            <key>default</key><real>1.0</real>
            <key>min</key><real>0.6</real>
            <key>max</key><real>1.5</real>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>流动渐变背景</string>
